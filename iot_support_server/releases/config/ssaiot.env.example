# Template for ssaiot.env (not tracked by git).
# Copy to ssaiot.env and fill in; setup.sh installs it at /etc/ssaiot/ssaiot.env,
# which every module's systemd unit loads via EnvironmentFile. setup.sh also
# renders nginx.conf.template with SERVER_DOMAIN and MINIO_ENDPOINT.
#   cp ssaiot.env.example ssaiot.env

# Public domain of this server (nginx server_name, OTA download links), e.g. ssaiot.example.com
SERVER_DOMAIN=

# health_checker, sensor_data_collector
INFLUXDB_URL=
INFLUXDB_TOKEN=

# log_collector
LOKI_URL=

# ota_server (MINIO_ENDPOINT is host only, no scheme)
MINIO_ENDPOINT=
MINIO_ACCESS_KEY_ID=
MINIO_SECRET_ACCESS_KEY=

# notification_system
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
