# /etc/nginx/nginx.conf — template rendered by setup.sh from ssaiot.env (SERVER_DOMAIN, MINIO_ENDPOINT)

user www-data;
worker_processes auto;
pid /run/nginx.pid;

load_module /usr/lib/nginx/modules/ngx_stream_module.so;

events {
    worker_connections 1024;
}

# ─── HTTP / HTTPS ────────────────────────────────────────────────────────────
http {

    error_log /var/log/nginx/error.log debug;

    # Redireciona HTTP → HTTPS
    server {
        listen 80;
        server_name ${SERVER_DOMAIN};
        return 301 https://$host$request_uri;
    }

    server {
        # ─── DEBUG: TLS/mTLS temporariamente desativado ──────────────────────────
        # Para reverter, comente a linha "listen 443;" abaixo, descomente o
        # bloco original e restaure "listen 443 ssl;".
        listen 443;
        server_name ${SERVER_DOMAIN};

        # ssl_buffer_size 4k;
        #
        # # Certificados do servidor — gerados pelo certbot
        # ssl_certificate     /etc/letsencrypt/live/${SERVER_DOMAIN}/fullchain.pem;
        # ssl_certificate_key /etc/letsencrypt/live/${SERVER_DOMAIN}/privkey.pem;
        #
        # # Protocolos e cifras modernas
        # ssl_protocols TLSv1.2 TLSv1.3;
        # ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES128-GCM-SHA256;
        # ssl_prefer_server_ciphers on;
        #
        # # mTLS — valida certificado do cliente com sua CA privada
        # ssl_client_certificate /root/certs/cas/ca.crt;
        # ssl_verify_client on;

        # Passa a identidade do cliente para a aplicação (sem mTLS, fica sempre vazio)
        # proxy_set_header X-SSL-Client-DN $ssl_client_s_dn;
        # proxy_set_header X-SSL-Client-CN $ssl_client_s_dn;

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Host              $host;

        # ─── Root → 204 No Content ───────────────────────────────────────────────
        location = / {
            return 204;
        }

        # ─── OTA firmware download proxy ─────────────────────────────────────────
        # URL pública:  /firmware/download/<path>?<presigned-args>
        # URL interna:  https://${MINIO_ENDPOINT}/firmware/<path>?<presigned-args>
        location ~ ^/firmware/download/(?<ota_path>.+)$ {
            resolver 127.0.0.53 valid=300s;
            resolver_timeout 5s;

            proxy_pass https://${MINIO_ENDPOINT}/firmware/$ota_path$is_args$args;

            proxy_ssl_verify off;

            proxy_pass_request_headers off;
            proxy_set_header Host ${MINIO_ENDPOINT};

            proxy_set_header X-SSL-Client-DN   "";
            proxy_set_header X-SSL-Client-CN   "";
            proxy_set_header X-Real-IP         "";
            proxy_set_header X-Forwarded-For   "";
            proxy_set_header X-Forwarded-Proto "";
        }

        # ─── /firmware/* → backend 8080 ──────────────────────────────────────────
        location /firmware {
            proxy_pass http://127.0.0.1:8080;
        }
    }

}

# ─── MQTT / MQTTS ────────────────────────────────────────────────────────────
stream {

    log_format basic '$remote_addr $upstream_addr [$time_local] '
                     '$protocol $status $bytes_sent $bytes_received';

    access_log /var/log/nginx/stream_access.log basic;
    error_log  /var/log/nginx/stream_error.log debug;

    server {
        # ─── DEBUG: TLS/mTLS temporariamente desativado ──────────────────────────
        # Para reverter, restaure "listen 8883 ssl;" e descomente o bloco abaixo.
        listen 8883;

        # # Mesmo certificado do servidor
        # ssl_certificate     /etc/letsencrypt/live/${SERVER_DOMAIN}/fullchain.pem;
        # ssl_certificate_key /etc/letsencrypt/live/${SERVER_DOMAIN}/privkey.pem;
        #
        # ssl_protocols TLSv1.2 TLSv1.3;
        # ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES128-GCM-SHA256;
        # ssl_prefer_server_ciphers on;
        #
        # # mTLS
        # ssl_client_certificate /root/certs/cas/ca.crt;
        # ssl_verify_client on;

        # Repassa para o Mosquitto interno
        proxy_pass localhost:1883;
    }
}